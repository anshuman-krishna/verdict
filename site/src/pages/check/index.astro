---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Check a listing"
  description="Paste an Amazon product link and Verdict will analyse it."
>
  <h1>Check a listing</h1>
  <p>Paste an Amazon product link and Verdict will analyse it.</p>

  <p>
    We could fetch the page from our own servers instead, and some tools do. That would mean
    telling us which product you are looking at, and it would mean requesting Amazon pages at
    scale from our infrastructure. We are not willing to do the first and not able to sustain
    the second. So the fetch happens in your browser, in your session, exactly as if you had
    opened the page yourself.
  </p>

  <div id="fallback">
    <p>Verdict needs the extension to do this.</p>
    <p>
      <a class="button-primary" href="/install">Add Verdict to your browser</a>
    </p>
  </div>

  <form id="app" hidden>
    <label for="url">Product link</label><br />
    <input id="url" name="url" type="url" required placeholder="https://www.amazon.com/dp/..." />
    <button type="submit" class="button-primary">Check</button>
    <p id="result" role="status"></p>
  </form>

  <script>
    // SPEC.md section 11, the other of the two islands SITE.md names.
    // extension/src/entrypoints/presence.content.ts sets
    // data-verdict-installed and data-verdict-extension-id at
    // document_start. the analyze pipeline behind an allowed domain is
    // not built yet (extension/src/bridge/handler.ts returns
    // "not-implemented" honestly, see AnalyzeResponse), so a working
    // extension still cannot produce a report here today. this form
    // exists so the moment that pipeline exists, this page needs no
    // further wiring, and until then it says exactly what state it is
    // in rather than pretending to work or staying inert.

    const root = document.documentElement;

    function sendToExtension(type: string, extra: Record<string, unknown>): Promise<any> {
      return new Promise((resolve, reject) => {
        const extensionId = root.dataset.verdictExtensionId;
        const runtime = (window as any).chrome?.runtime;
        if (!extensionId || !runtime?.sendMessage) {
          reject(new Error("no cross extension messaging available in this browser"));
          return;
        }
        runtime.sendMessage(extensionId, { type, ...extra }, (response: unknown) => {
          if (runtime.lastError) {
            reject(new Error(runtime.lastError.message));
            return;
          }
          resolve(response);
        });
      });
    }

    function init(): void {
      if (root.dataset.verdictInstalled !== "true") {
        return;
      }
      document.getElementById("fallback")?.setAttribute("hidden", "");
      const form = document.getElementById("app") as HTMLFormElement | null;
      const result = document.getElementById("result");
      if (form === null || result === null) {
        return;
      }
      form.hidden = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const url = (document.getElementById("url") as HTMLInputElement).value;
        result.textContent = "Checking…";
        try {
          const response = await sendToExtension("verdict:analyze", { url });
          result.textContent = describe(response);
        } catch {
          result.textContent = "Could not reach the extension. Try reloading the page.";
        }
      });
    }

    function describe(response: { status?: string }): string {
      switch (response.status) {
        case "unsupported-domain":
          return "That is not one of the storefronts Verdict currently supports.";
        case "not-implemented":
          return "Verdict recognised that link, but the analysis pipeline for it is not built yet.";
        default:
          return "Something went wrong reaching the extension.";
      }
    }

    init();
  </script>
</Layout>
