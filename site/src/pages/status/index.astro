---
import Layout from "../../layouts/Layout.astro";
import status from "../../data/status.json";

const { rows, generatedAt } = status;

const HEALTH_LABELS: Record<string, string> = {
  healthy: "reading correctly",
  degraded: "reading less than expected",
  failed: "not reading",
};

function formatDate(seconds: number): string {
  return new Date(seconds * 1000).toISOString().slice(0, 10);
}
---

<Layout title="Status" description="Extraction health per site and locale.">
  <h1>Status</h1>
  <p>
    When Amazon changes their page layout, Verdict stops reading it correctly. This page tells
    you whether that has happened, before you have to wonder why a report looks wrong.
  </p>
  {
    rows.length > 0 && (
      <p>
        Last run <span class="data">{formatDate(generatedAt)}</span>.
      </p>
    )
  }
  <div class="table-scroll">
    <table class="register">
      <thead>
        <tr>
          <th>Site</th>
          <th>Locale</th>
          <th>Last verified</th>
          <th>Extraction health</th>
          <th>Rules version</th>
          <th>Median reviews extracted</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.length === 0 ? (
            <tr>
              <td colspan="6">No canary runs yet.</td>
            </tr>
          ) : (
            rows.map((row) => (
              <tr>
                <td>{row.site}</td>
                <td>{row.locale}</td>
                <td class="data">{formatDate(row.lastVerified)}</td>
                {/* DESIGN.md section 11: health never depends on colour
                    alone, so the words carry it and the tint only agrees. */}
                <td class={row.status === "healthy" ? undefined : "unhealthy"}>
                  {HEALTH_LABELS[row.status] ?? row.status}
                </td>
                <td class={row.rulesVersion === null ? undefined : "data"}>
                  {row.rulesVersion ?? "unknown"}
                </td>
                <td class={row.medianReviewsExtracted === null ? undefined : "data"}>
                  {row.medianReviewsExtracted ?? "none read"}
                </td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
</Layout>

<style>
  .table-scroll {
    overflow-x: auto;
  }

  .unhealthy {
    color: var(--cancel);
  }
</style>
