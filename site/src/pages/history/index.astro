---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Your history"
  description="Every check you have run, stored in the extension on this machine."
>
  <h1>Your history</h1>
  <p>
    Every check you have run, stored in the extension on this machine. It has never been sent
    anywhere and there is no account attached to it.
  </p>

  <div id="fallback">
    <p>
      Your history lives inside the extension. Install Verdict and it will appear here.
    </p>
    <p>
      <a class="button-primary" href="/install">Add Verdict to your browser</a>
    </p>
  </div>

  <div id="app" hidden></div>

  <script>

    import { BAND_COLORS, BAND_LABELS, ROSETTE, UNKNOWN_BAND_COLOR } from "../../lib/rosette";
    const DOUBTFUL_OR_WORSE = new Set(["doubtful", "heavily-manipulated"]);

    interface HistorySummaryEntry {
      id: number;
      timestamp: number;
      title: string;
      thumbnailUrl: string | null;
      band: string | null;
      claimedRating: number | null;
      adjustedRating: number | null;
      estimatedInorganicShare: number | null;
      productKey: string | null;
      checkCount?: number;
    }

    // repeat checks of one listing collapse to the newest, the rest sit behind it
    function groupByProduct(entries: HistorySummaryEntry[]): HistorySummaryEntry[] {
      const newestFor = new Map<string, HistorySummaryEntry>();
      const rows: HistorySummaryEntry[] = [];
      for (const entry of entries) {
        if (entry.productKey === null) {
          rows.push({ ...entry, checkCount: 1 });
          continue;
        }
        const seen = newestFor.get(entry.productKey);
        if (seen === undefined) {
          const row = { ...entry, checkCount: 1 };
          newestFor.set(entry.productKey, row);
          rows.push(row);
          continue;
        }
        seen.checkCount = (seen.checkCount ?? 1) + 1;
      }
      return rows;
    }

    function earlierChecks(entry: HistorySummaryEntry): HistorySummaryEntry[] {
      if (entry.productKey === null) {
        return [];
      }
      return allEntries.filter(
        (candidate) =>
          candidate.productKey === entry.productKey && candidate.timestamp < entry.timestamp,
      );
    }

    const root = document.documentElement;
    let allEntries: HistorySummaryEntry[] = [];

    function sendToExtension(type: string, extra: Record<string, unknown> = {}): Promise<any> {
      return new Promise((resolve, reject) => {
        const extensionId = root.dataset.verdictExtensionId;
        const runtime = (window as any).chrome?.runtime;
        if (!extensionId || !runtime?.sendMessage) {
          reject(new Error("no cross extension messaging available in this browser"));
          return;
        }
        runtime.sendMessage(extensionId, { type, ...extra }, (response: unknown) => {
          if (runtime.lastError) {
            reject(new Error(runtime.lastError.message));
            return;
          }
          resolve(response);
        });
      });
    }

    function formatDate(timestamp: number): string {
      return new Date(timestamp).toLocaleDateString(undefined, {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
    }

    // quotes included, because these values land in attributes as well as in text
    function escapeHtml(value: string): string {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function rosetteThumbnail(band: string | null, share: number | null): string {
      const color = band !== null ? (BAND_COLORS[band] ?? UNKNOWN_BAND_COLOR) : UNKNOWN_BAND_COLOR;
      const clampedShare = Math.min(1, Math.max(0, share ?? 0));
      const amplitude = ROSETTE.minAmplitude + (ROSETTE.maxAmplitude - ROSETTE.minAmplitude) * clampedShare;
      const harmonicA = 3;
      const harmonicB = 4;
      const radius = 14;
      const samples = 60;
      const points: string[] = [];
      for (let i = 0; i <= samples; i++) {
        const t = (i / samples) * Math.PI * 2;
        const r = radius * (1 + (amplitude * (Math.cos(harmonicA * t) - Math.cos(harmonicB * t))) / 2);
        points.push(`${(r * Math.cos(t)).toFixed(2)},${(r * Math.sin(t)).toFixed(2)}`);
      }
      return `<svg class="rosette-thumb" viewBox="-16 -16 32 32" role="presentation">
        <polygon points="${points.join(" ")}" fill="none" stroke="${color}" stroke-width="1.5" />
      </svg>`;
    }

    async function download(format: "json" | "csv"): Promise<void> {
      const response = await sendToExtension("verdict:history:export", { format });
      if (typeof response?.content !== "string") {
        return;
      }
      const blob = new Blob([response.content], {
        type: format === "json" ? "application/json" : "text/csv",
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = response.filename ?? `verdict-history.${format}`;
      link.click();
      URL.revokeObjectURL(url);
    }

    function renderFigures(container: HTMLElement, entries: HistorySummaryEntry[]): void {
      const checksRun = entries.length;
      // a listing checked twenty times is one listing, not twenty, for these two
      const listings = groupByProduct(entries);
      const gaps = listings
        .filter((e) => e.claimedRating !== null && e.adjustedRating !== null)
        .map((e) => Math.abs((e.claimedRating as number) - (e.adjustedRating as number)));
      const averageGap = gaps.length > 0 ? gaps.reduce((a, b) => a + b, 0) / gaps.length : null;
      const banded = listings.filter((e) => e.band !== null);
      const shareDoubtful =
        banded.length > 0
          ? banded.filter((e) => DOUBTFUL_OR_WORSE.has(e.band as string)).length / banded.length
          : null;

      container.innerHTML = `
        <dl class="figures">
          <div><dd>${checksRun.toLocaleString()}</dd><dt>checks run</dt></div>
          <div><dd>${listings.length.toLocaleString()}</dd><dt>listings checked</dt></div>
          <div><dd>${averageGap !== null ? averageGap.toFixed(1) : "n/a"}</dd><dt>average gap per listing, claimed to adjusted</dt></div>
          <div><dd>${shareDoubtful !== null ? Math.round(shareDoubtful * 100) + "%" : "n/a"}</dd><dt>listings doubtful or worse</dt></div>
        </dl>
      `;
    }

    function applyFilters(
      entries: HistorySummaryEntry[],
      search: string,
      band: string,
      sort: string,
    ): HistorySummaryEntry[] {
      const needle = search.trim().toLowerCase();
      let filtered = entries.filter((e) => {
        if (needle !== "" && !e.title.toLowerCase().includes(needle)) {
          return false;
        }
        if (band !== "" && e.band !== band) {
          return false;
        }
        return true;
      });
      filtered = [...filtered].sort((a, b) => {
        switch (sort) {
          case "date-asc":
            return a.timestamp - b.timestamp;
          case "gap-desc": {
            const gapA =
              a.claimedRating !== null && a.adjustedRating !== null
                ? Math.abs(a.claimedRating - a.adjustedRating)
                : -1;
            const gapB =
              b.claimedRating !== null && b.adjustedRating !== null
                ? Math.abs(b.claimedRating - b.adjustedRating)
                : -1;
            return gapB - gapA;
          }
          case "title-asc":
            return a.title.localeCompare(b.title);
          case "date-desc":
          default:
            return b.timestamp - a.timestamp;
        }
      });
      return filtered;
    }

    function renderTable(tableContainer: HTMLElement, entries: HistorySummaryEntry[]): void {
      if (entries.length === 0) {
        tableContainer.innerHTML = "<p>No checks match.</p>";
        return;
      }
      const rows = entries
        .map((entry) => {
          const band =
            entry.band !== null && entry.band in BAND_LABELS
              ? `<span style="color:${BAND_COLORS[entry.band]}">${BAND_LABELS[entry.band]}</span>`
              : "";
          const claimed = entry.claimedRating !== null ? entry.claimedRating.toFixed(1) : "";
          const adjusted = entry.adjustedRating !== null ? entry.adjustedRating.toFixed(1) : "";
          const thumb = rosetteThumbnail(entry.band, entry.estimatedInorganicShare);
          const repeat =
            (entry.checkCount ?? 1) > 1 ? ` <span class="repeat">${entry.checkCount}&times;</span>` : "";
          const title = `<button type="button" class="open-report" data-id="${entry.id}" aria-expanded="false">${escapeHtml(entry.title)}</button>${repeat}`;
          return `<tr data-row="${entry.id}"><td>${thumb}</td><td>${formatDate(entry.timestamp)}</td><td>${title}</td><td>${claimed}</td><td>${adjusted}</td><td>${band}</td></tr>`;
        })
        .join("");
      tableContainer.innerHTML = `
        <div class="table-scroll">
          <table class="register">
            <thead>
              <tr><th></th><th>Date</th><th>Product</th><th>Claimed</th><th>Adjusted</th><th>Band</th></tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      `;
      wireOpenReport(tableContainer);
    }

    interface StoredEvidenceRow {
      signal: string;
      strength: string;
      detail: string;
    }

    interface StoredReport {
      band: string;
      claimedRating: number;
      adjustedRating: number;
      totalReviewCount: number;
      excludedReviewCount: number;
      confidence: { low: number; high: number };
      evidence: StoredEvidenceRow[];
      unavailableSignals: string[];
      serial: string;
    }

    function reportMarkup(report: StoredReport): string {
      const low = Math.round(report.confidence.low * 100);
      const high = Math.round(report.confidence.high * 100);
      const range = low === high ? `${low} percent` : `${low} to ${high} percent`;
      const kept = report.totalReviewCount - report.excludedReviewCount;
      const evidence = report.evidence
        .map(
          (row) =>
            `<div class="evidence-row"><span>${escapeHtml(row.signal)}</span>` +
            `<span class="evidence-strength">${escapeHtml(row.strength)}</span>` +
            `<p>${escapeHtml(row.detail)}</p></div>`,
        )
        .join("");
      const unavailable =
        report.unavailableSignals.length === 0
          ? ""
          : `<p class="report-note">${escapeHtml(report.unavailableSignals.join(", "))} could not be read on this page, which widens the estimate.</p>`;
      const serial = report.serial === "" ? "" : `<p class="report-serial">${escapeHtml(report.serial)}</p>`;
      return `
        <p class="report-note">Estimated ${range} of reviews. ${kept.toLocaleString()} kept, ${report.excludedReviewCount.toLocaleString()} excluded.</p>
        ${unavailable}
        <div class="evidence">${evidence}</div>
        ${serial}
      `;
    }

    function earlierMarkup(checks: HistorySummaryEntry[]): string {
      if (checks.length === 0) {
        return "";
      }
      const rows = checks
        .map((check) => {
          const band =
            check.band !== null && check.band in BAND_LABELS ? BAND_LABELS[check.band] : "";
          const adjusted = check.adjustedRating !== null ? check.adjustedRating.toFixed(1) : "";
          return `<div class="earlier-row"><span>${formatDate(check.timestamp)}</span><span>${band}</span><span>${adjusted}</span></div>`;
        })
        .join("");
      return `<p class="report-note">Earlier checks of this listing</p><div class="earlier">${rows}</div>`;
    }

    function wireOpenReport(tableContainer: HTMLElement): void {
      for (const button of tableContainer.querySelectorAll<HTMLButtonElement>(".open-report")) {
        button.addEventListener("click", async () => {
          const id = Number(button.dataset.id);
          const row = tableContainer.querySelector<HTMLTableRowElement>(`tr[data-row="${id}"]`);
          const open = tableContainer.querySelector<HTMLTableRowElement>(`tr[data-detail="${id}"]`);
          if (open !== null) {
            open.remove();
            button.setAttribute("aria-expanded", "false");
            return;
          }
          if (row === null) {
            return;
          }
          const detail = document.createElement("tr");
          detail.dataset.detail = String(id);
          detail.innerHTML = `<td colspan="6" class="report-cell">Reading the report.</td>`;
          row.after(detail);
          button.setAttribute("aria-expanded", "true");
          const cell = detail.querySelector("td") as HTMLElement;
          try {
            const response = await sendToExtension("verdict:report:get", { id });
            const entry = allEntries.find((candidate) => candidate.id === id);
            const report =
              response?.report == null
                ? "<p>This check was saved by an older version, so only its heading is readable.</p>"
                : reportMarkup(response.report as StoredReport);
            cell.innerHTML = report + (entry === undefined ? "" : earlierMarkup(earlierChecks(entry)));
          } catch {
            cell.textContent = "The extension did not answer, so this report could not be read.";
          }
        });
      }
    }

    function renderControlsAndTable(app: HTMLElement): void {
      const searchInput = app.querySelector<HTMLInputElement>("#history-search");
      const bandSelect = app.querySelector<HTMLSelectElement>("#history-band");
      const sortSelect = app.querySelector<HTMLSelectElement>("#history-sort");
      const tableContainer = app.querySelector<HTMLElement>("#history-table");
      if (searchInput === null || bandSelect === null || sortSelect === null || tableContainer === null) {
        return;
      }
      const rerender = () => {
        const filtered = applyFilters(
          groupByProduct(allEntries),
          searchInput.value,
          bandSelect.value,
          sortSelect.value,
        );
        renderTable(tableContainer, filtered);
      };
      searchInput.addEventListener("input", rerender);
      bandSelect.addEventListener("change", rerender);
      sortSelect.addEventListener("change", rerender);
      rerender();
    }

    function renderEntries(app: HTMLElement, entries: HistorySummaryEntry[]): void {
      allEntries = entries;
      if (entries.length === 0) {
        app.innerHTML = "<p>No checks yet.</p>";
        return;
      }
      const bandOptions = Object.entries(BAND_LABELS)
        .map(([value, label]) => `<option value="${value}">${label}</option>`)
        .join("");
      app.innerHTML = `
        <div id="history-figures"></div>
        <div class="controls">
          <input type="search" id="history-search" placeholder="Search by title" aria-label="Search by title" />
          <select id="history-band" aria-label="Filter by band">
            <option value="">Every band</option>
            ${bandOptions}
          </select>
          <select id="history-sort" aria-label="Sort">
            <option value="date-desc">Newest first</option>
            <option value="date-asc">Oldest first</option>
            <option value="gap-desc">Largest gap first</option>
            <option value="title-asc">Title, A to Z</option>
          </select>
        </div>
        <div id="history-table"></div>
        <p class="history-actions">
          <button type="button" id="export-json" class="button-secondary">Export as JSON</button>
          <button type="button" id="export-csv" class="button-secondary">Export as CSV</button>
          <button type="button" id="clear-history" class="button-secondary">Delete everything</button>
        </p>
      `;
      renderFigures(app.querySelector("#history-figures") as HTMLElement, entries);
      renderControlsAndTable(app);
      document.getElementById("export-json")?.addEventListener("click", () => download("json"));
      document.getElementById("export-csv")?.addEventListener("click", () => download("csv"));
      document.getElementById("clear-history")?.addEventListener("click", async () => {
        await sendToExtension("verdict:history:clear");
        renderEntries(app, []);
      });
    }

    async function init(): Promise<void> {
      if (root.dataset.verdictInstalled !== "true") {
        return;
      }
      document.getElementById("fallback")?.setAttribute("hidden", "");
      const app = document.getElementById("app");
      if (app === null) {
        return;
      }
      app.hidden = false;
      app.innerHTML = "<p>Loading your history…</p>";
      try {
        const response = await sendToExtension("verdict:history:list");
        renderEntries(app, response.entries);
      } catch {
        app.innerHTML = "<p>Could not reach the extension. Try reloading the page.</p>";
      }
    }

    void init();
  </script>
</Layout>

<style>
  .history-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .figures {
    display: flex;
    gap: 32px;
    margin: 16px 0;
    font-family: "Fragment Mono", ui-monospace, monospace;
  }

  .figures div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .figures dd {
    margin: 0;
    font-size: 1.5rem;
  }

  .figures dt {
    margin: 0;
    font-family: "Public Sans", system-ui, sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .controls {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .open-report {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .repeat {
    font-family: "Fragment Mono", ui-monospace, monospace;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .earlier-row {
    display: flex;
    gap: 16px;
    padding: 2px 0;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .report-cell {
    background: var(--paper-sunk, transparent);
  }

  .report-note,
  .report-serial {
    margin: 4px 0;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .report-serial {
    font-family: "Fragment Mono", ui-monospace, monospace;
  }

  .evidence-row {
    margin: 8px 0;
  }

  .evidence-row p {
    margin: 2px 0 0;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .evidence-strength {
    margin-left: 8px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .rosette-thumb {
    width: 24px;
    height: 24px;
    display: block;
  }
</style>
