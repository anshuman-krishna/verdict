---
import { rosettePath, type RosetteParams } from "../lib/rosette";

interface Props {
  bandLabel: string;
  claimedRating: number;
  adjustedRating: number;
  totalReviewCount: number;
  excludedReviewCount: number;
  serial: string;
  rosette: RosetteParams;
}

const {
  bandLabel,
  claimedRating,
  adjustedRating,
  totalReviewCount,
  excludedReviewCount,
  serial,
  rosette,
} = Astro.props;

const keptCount = totalReviewCount - excludedReviewCount;
const path = rosettePath(rosette, 44);
---

<div class="certificate">
  <svg
    class="rosette"
    viewBox="-50 -50 100 100"
    role="img"
    aria-label={`${bandLabel}, estimated ${Math.round((excludedReviewCount / totalReviewCount) * 100)} percent of reviews are inorganic`}
  >
    <path d={path} fill="none" stroke={rosette.strokeColor} stroke-width="1.5" />
  </svg>
  <dl class="figures">
    <div>
      <dd class="data">{adjustedRating.toFixed(1)}</dd>
      <dt>adjusted</dt>
    </div>
    <div>
      <dd class="data">{claimedRating.toFixed(1)}</dd>
      <dt>claimed</dt>
    </div>
  </dl>
  <p class="summary">
    {excludedReviewCount.toLocaleString()} of {totalReviewCount.toLocaleString()} reviews
    excluded
  </p>
  <div class="specimen-strip">
    <div class="kept" style={`flex-grow: ${keptCount}`}></div>
    <div class="excluded" style={`flex-grow: ${excludedReviewCount}`}></div>
  </div>
  <p class="serial data">serial {serial}</p>
</div>

<style>
  .certificate {
    max-width: 320px;
  }

  .rosette {
    width: 88px;
    height: 88px;
  }

  .figures {
    display: flex;
    gap: 20px;
    margin: 12px 0 0;
  }

  .figures div {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .figures dd {
    margin: 0;
    font-size: 1.75rem;
  }

  .figures dt {
    margin: 0;
    color: var(--ink-soft);
    font-family: "Public Sans", system-ui, sans-serif;
  }

  .summary {
    margin: 12px 0 0;
    font-size: 0.9375rem;
  }

  .specimen-strip {
    display: flex;
    height: 10px;
    margin-top: 8px;
    border-radius: 1px;
    overflow: hidden;
  }

  .specimen-strip .kept {
    background: var(--accent);
  }

  .specimen-strip .excluded {
    background-image: repeating-linear-gradient(
      45deg,
      var(--cancel),
      var(--cancel) 2px,
      transparent 2px,
      transparent 4px
    );
    background-color: var(--paper-sunk);
  }

  .serial {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
</style>
